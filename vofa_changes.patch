+void Usart_RxCallBack_StartDmaReception(void)
+{
+  (void)HAL_UARTEx_ReceiveToIdle_DMA(&huart4, vofa_rx_active_buf, USART_RXCALLBACK_VOFA_RX_BUF_SIZE);
